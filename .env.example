# Copy to .env (or export these) before running in production.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL. If DB_NAME is empty the project falls back to local SQLite.
DB_NAME=inkhobby
DB_USER=inkhobby
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Google sign-in (Google Cloud Console > OAuth client, redirect URI:
# http://localhost:8000/accounts/google/login/callback/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chapter translation (Google Cloud Translation API key). Leave empty to disable.
GOOGLE_TRANSLATE_API_KEY=

# "mock" credits coins without charging anyone. Never use in production.
PAYMENTS_MODE=mock

SITE_CONTACT_EMAIL=hello@inkhobby.com
ACCOUNT_EMAIL_VERIFICATION=optional

# SMTP (used when DJANGO_DEBUG=false)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
